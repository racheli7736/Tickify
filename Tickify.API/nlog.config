<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${aspnet-appbasepath}/logs/nlog-internal.log">

  <!-- The log level per category comes from appsettings (Logging:LogLevel); the rules below only route and filter. -->

  <!-- Logs live next to the application (Tickify.API/logs in development); the folder is git-ignored. -->
  <variable name="logDir" value="${aspnet-appbasepath}/logs" />

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <!-- Human readable, for the developer. CorrelationId comes from the scope opened by CorrelationIdMiddleware. -->
    <target xsi:type="Console" name="console"
            layout="${longdate} ${level:uppercase=true} [${scopeproperty:CorrelationId}] ${logger} ${message} ${exception:format=tostring}" />

    <!-- Files share one structured layout (one JSON object per line) and the same rolling/retention settings:
         the current file is rolled every day (and at 10 MB) into logs/archive; archives older than 14 days are deleted. -->
    <default-target-parameters xsi:type="File"
                               archiveAboveSize="10485760"
                               archiveEvery="Day"
                               archiveSuffixFormat="-{1:yyyyMMdd}.{0:00}"
                               maxArchiveDays="14"
                               keepFileOpen="false"
                               encoding="utf-8">
      <layout xsi:type="JsonLayout" includeEventProperties="true" includeScopeProperties="false">
        <attribute name="time" layout="${date:format=O}" />
        <attribute name="level" layout="${level}" />
        <attribute name="correlationId" layout="${scopeproperty:CorrelationId}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
      </layout>
    </default-target-parameters>

    <target xsi:type="File" name="appFile" fileName="${logDir}/app.log" archiveFileName="${logDir}/archive/app.log" />

    <!-- Errors only, kept apart so they are easy to find. -->
    <target xsi:type="File" name="errorFile" fileName="${logDir}/errors.log" archiveFileName="${logDir}/archive/errors.log" />
  </targets>

  <rules>
    <!-- Keep the "listening on" line visible, hide the rest of the framework noise below Warning. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,appFile" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Trace" writeTo="console,appFile" />
    <logger name="*" minlevel="Error" writeTo="errorFile" />
  </rules>
</nlog>
